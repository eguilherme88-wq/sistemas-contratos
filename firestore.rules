rules_version = '2';
// Regras do banco Firestore do Partner — Gestão de Contratos.
// Só quem tem perfil cadastrado (coleção "perfis") acessa os dados.
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }
    function caminhoPerfil() { return /databases/$(database)/documents/perfis/$(request.auth.uid); }
    function temPerfil() { return logado() && exists(caminhoPerfil()); }
    function nivel() { return get(caminhoPerfil()).data.perfil; }
    function gestor() { return temPerfil() && nivel() in ['admin', 'master']; }
    function admin() { return temPerfil() && nivel() == 'admin'; }
    function semAdministrador() { return !exists(/databases/$(database)/documents/config/inicial); }

    // Marca de que o primeiro administrador já foi criado (lida antes do login).
    match /config/inicial {
      allow read: if true;
      allow create: if logado() && semAdministrador();
    }

    match /perfis/{uid} {
      allow read: if temPerfil() || (logado() && request.auth.uid == uid);
      // Gestores cadastram usuários; o primeiro administrador cria o próprio perfil.
      allow create: if gestor()
        || (logado() && request.auth.uid == uid && semAdministrador() && request.resource.data.perfil == 'admin');
      // Cada um pode atualizar o próprio perfil, sem mudar nível, acessos ou período de teste.
      allow update: if gestor()
        || (logado() && request.auth.uid == uid
            && request.resource.data.perfil == resource.data.perfil
            && request.resource.data.acessos == resource.data.acessos
            && request.resource.data.get('trialFim', null) == resource.data.get('trialFim', null));
      allow delete: if gestor();
    }

    // Cópia das senhas visível só ao Administrador.
    match /senhas/{uid} {
      allow read: if admin();
      allow write: if gestor() || (logado() && request.auth.uid == uid);
    }

    // Cópias de PDF para a contratante baixar pelo link (gov.br): leitura pública só com o token, enquanto não expirar
    match /documentosPublicos/{token} {
      allow get: if resource.data.expiraEm > request.time;
      allow create, update, delete: if temPerfil();
      match /partes/{parte} {
        allow get: if get(/databases/$(database)/documents/documentosPublicos/$(token)).data.expiraEm > request.time;
        allow create, update, delete: if temPerfil();
      }
    }

    match /arquivos/{id}/partes/{parte} {
      allow read, write: if temPerfil();
    }

    match /{colecao}/{id} {
      allow read, write: if temPerfil()
        && colecao in ['contratos', 'contratosExternos', 'partes', 'tiposServico', 'config', 'arquivos'];
    }
  }
}
